{
  "name": "lumicsec",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.19.0",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @lumicsec/shared build && pnpm --filter @lumicsec/validation build && pnpm --filter @lumicsec/api-security-engine build && pnpm --filter @lumicsec/web-security-engine build && pnpm --parallel --filter @lumicsec/web --filter @lumicsec/api dev",
    "dev:web": "pnpm --filter @lumicsec/web dev",
    "dev:api": "pnpm --filter @lumicsec/api dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:audit": "pnpm audit --audit-level high"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.0"
  }
}
