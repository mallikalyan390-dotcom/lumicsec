{
  "name": "lumicsec",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.19.0",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @lumicsec/shared build && pnpm --filter @lumicsec/validation build && pnpm --filter @lumicsec/api-security-engine build && pnpm --filter @lumicsec/web-security-engine build && pnpm --parallel --filter @lumicsec/web --filter @lumicsec/api dev",
    "dev:web": "pnpm --filter @lumicsec/web dev",
    "dev:api": "pnpm --filter @lumicsec/api dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --workspace-concurrency=2 --if-present test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:audit": "pnpm audit --prod --audit-level high",
    "build:isolated-web": "pnpm --filter @lumicsec/api build:isolated-web",
    "test:isolated-web": "pnpm build:isolated-web && pnpm --filter @lumicsec/api test:sandbox",
    "test:web-browsers": "node apps/web/tests/run-isolated-browser-docker.mjs",
    "test:findings-browsers": "node apps/web/tests/run-findings-browser-docker.mjs",
    "build:controlled-runtime": "pnpm --filter @lumicsec/api build:controlled-runtime",
    "test:controlled-runtime": "pnpm build:controlled-runtime && pnpm --filter @lumicsec/api test:controlled-runtime",
    "capture:controlled-runtime": "pnpm build:controlled-runtime && pnpm --filter @lumicsec/api capture:controlled-runtime",
    "build:confined-broker": "pnpm --filter @lumicsec/api build:confined-broker",
    "test:confined-broker": "pnpm build:controlled-runtime && pnpm build:confined-broker && pnpm --filter @lumicsec/api test:confined-broker",
    "test:authorized-plan-fixture": "pnpm build:controlled-runtime && pnpm build:confined-broker && pnpm --filter @lumicsec/api test:authorized-plan-fixture",
    "test:restricted-egress": "pnpm build:controlled-runtime && pnpm build:confined-broker && pnpm --filter @lumicsec/api test:restricted-egress",
    "test:broker-ticket-docker": "pnpm build:confined-broker && pnpm --filter @lumicsec/api test:broker-ticket-docker"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.0"
  },
  "type": "module"
}
