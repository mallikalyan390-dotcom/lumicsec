# Supabase project configuration. Use the project Connect dialog.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only key for future trusted worker operations. Never prefix with VITE_.
# Do not set this until a worker requires it.
SUPABASE_SECRET_KEY=

# Local application URLs. OAuth callback URL must be added to Supabase Auth redirect allowlist.
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8787
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cookie domain is blank for localhost. Production may use .lumicsec.com.
COOKIE_DOMAIN=
HOST=127.0.0.1
PORT=8787
NODE_ENV=development
LOG_LEVEL=info
